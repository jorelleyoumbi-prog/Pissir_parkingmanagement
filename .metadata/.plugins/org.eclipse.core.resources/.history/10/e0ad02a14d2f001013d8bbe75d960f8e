# Informazioni applicazione
spring.application.name=iot-service
server.port=8082

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/parkingdb?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=root
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
spring.jpa.open-in-view=false

# Configurazione MQTT
mqtt.enabled=true
mqtt.broker.url=tcp://localhost:1883
mqtt.client.id=iot-service-client
mqtt.topic.prefix=parkingsystem
mqtt.reconnect.delay=5000
mqtt.max.reconnect.attempts=12
mqtt.connection.timeout=10
mqtt.keep.alive.interval=60

# Configurazione MWbot
mwbot.charging.rate.kw=11.0
mwbot.low.battery.threshold=20
mwbot.maintenance.check.interval=300000

# Configurazione parcheggio
parking.hourly.rate=3.0
charging.rate.per.kwh=0.35
parking.currency=EUR
parking.reservation.max.duration.hours=24
parking.reservation.tolerance.minutes=30

# Configurazione notifiche
notification.enabled=true
notification.retry.count=3
notification.retry.delay=5000

# Configurazione logging
logging.level.root=INFO
logging.level.com.parkingsystem=DEBUG
logging.level.org.springframework=WARN
logging.level.org.hibernate=WARN
logging.file.name=logs/iot-service.log
logging.file.max-size=10MB
logging.file.max-history=30

# Configurazione sicurezza
jwt.secret=your-secret-key-for-jwt-should-be-at-least-256-bits-long-for-security
jwt.expiration=86400000