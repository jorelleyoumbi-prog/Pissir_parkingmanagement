    /**
     * Create a payment for a charging request
     * @param userId The user ID
     * @param chargingRequestId The charging request ID
     * @param paymentMethod The payment method
     * @return The created payment
     */
    public Payment createPaymentForChargingRequest(Long userId, Long chargingRequestId, String paymentMethod) {
        // Get user and charging request
        User user = userService.findById(userId);
        ChargingRequest chargingRequest = chargingRequestRepository.findById(chargingRequestId)
                .orElseThrow(() -> new ResourceNotFoundException("Charging request not found with id: " + chargingRequestId));
        
        // Validate that the charging request belongs to the user
        if (!chargingRequest.getUser().getId().equals(userId)) {
            throw new BadRequestException("Charging request does not belong to the user");
        }
        
        // Validate that the charging request is completed
        if (chargingRequest.getStatus() != ChargingRequest.ChargingStatus.COMPLETED) {
            throw new BadRequestException("Charging request is not completed");
        }
        
        // Calculate amount based on energy used
        double amount = 0;
        if (chargingRequest.getTotalEnergyKwh() != null) {
            amount = chargingRequest.getTotalEnergyKwh() * chargingRatePerKwh;
        } else {
            // Fallback calculation if total energy is not available
            double percentageCharged = chargingRequest.getTargetPercentage() - chargingRequest.getInitialPercentage();
            if (user.getBatteryCapacityKw() != null) {
                double kwhCharged = (percentageCharged / 100.0) * user.getBatteryCapacityKw();
                amount = kwhCharged * chargingRatePerKwh;
            } else {
                // Default amount if we can't calculate
                amount = 5.0;
            }
        }
        
        // Create payment
        Payment payment = new Payment();
        payment.setUser(user);
        payment.setChargingRequest(chargingRequest);
        payment.setAmount(amount);
        payment.setCurrency(currency);
        payment.setPaymentMethod(paymentMethod);
        payment.setStatus(Payment.PaymentStatus.COMPLETED);
        payment.setType(Payment.PaymentType.CHARGING);
        payment.setPaymentDate(LocalDateTime.now());
        payment.setTransactionId(generateTransactionId());
        
        // If credit card, store last 4 digits
        if (paymentMethod.equals("CREDIT_CARD") && user.getCreditCardNumber() != null) {
            String cardNumber = user.getCreditCardNumber();
            if (cardNumber.length() >= 4) {
                payment.setCardLastFour(cardNumber.substring(cardNumber.length() - 4));
            }
        }
        
        // Generate transaction ID
        payment.setTransactionId(generateTransactionId());
        
        return paymentRepository.save(payment);
    }
    
