    /**
     * Get revenue for a specific time range
     * @param startTime The start time
     * @param endTime The end time
     * @return Total revenue
     */
    public double getRevenueForTimeRange(LocalDateTime startTime, LocalDateTime endTime) {
        List<Payment> payments = paymentRepository.findByPaymentDateBetween(startTime, endTime);
        return payments.stream().mapToDouble(Payment::getAmount).sum();
    }
    
    /**
     * Generate a transaction ID
     * @return Transaction ID
     */
    private String generateTransactionId() {
        return "TXN-" + UUID.randomUUID().toString().substring(0, 8).toUpperCase();
    }
    
    public Payment createPaymentForParking(Long userId, Long parkingSpotId, String paymentMethod) {
        User user = userService.findById(userId);
        ParkingSpot parkingSpot = parkingService.getParkingSpotById(parkingSpotId);
        
        // Calcola la durata del parcheggio
        LocalDateTime startTime = parkingSpot.getOccupiedSince();
        LocalDateTime endTime = LocalDateTime.now();
        
        // Se non c'è un orario di inizio, utilizzare un valore predefinito di 1 ora
        double hoursParked = 1.0;
        if (startTime != null) {
            long minutesParked = ChronoUnit.MINUTES.between(startTime, endTime);
            hoursParked = Math.ceil(minutesParked / 60.0);
            if (hoursParked < 1) hoursParked = 1.0; // Minimo 1 ora
        }
        
        // Calcola l'importo da pagare
        double amount = hoursParked * parkingHourlyRate;
        
        System.out.println("Parking start time: " + startTime);
        System.out.println("Parking end time: " + endTime);
        System.out.println("Hours parked: " + hoursParked);
        System.out.println("Parking rate: " + parkingHourlyRate);
        System.out.println("Amount to pay: " + amount);
        
        // Crea il pagamento
        Payment payment = new Payment();
        payment.setUser(user);
        payment.setAmount(amount);
        payment.setCurrency(currency);
        payment.setPaymentMethod(paymentMethod);
        payment.setStatus(Payment.PaymentStatus.COMPLETED);
        payment.setType(Payment.PaymentType.PARKING_ONLY);
        payment.setPaymentDate(LocalDateTime.now());
