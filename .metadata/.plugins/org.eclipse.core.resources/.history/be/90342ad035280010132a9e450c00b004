    /**
     * Create a payment for a reservation
     * @param userId The user ID
     * @param reservationId The reservation ID
     * @param paymentMethod The payment method
     * @return The created payment
     */
    public Payment createPaymentForReservation(Long userId, Long reservationId, String paymentMethod) {
        // Get user and reservation
        User user = userService.findById(userId);
        Reservation reservation = reservationRepository.findById(reservationId)
                .orElseThrow(() -> new ResourceNotFoundException("Reservation not found with id: " + reservationId));
        
        // Validate that the reservation belongs to the user
        if (!reservation.getUser().getId().equals(userId)) {
            throw new BadRequestException("Reservation does not belong to the user");
        }
        
        // Calculate amount based on reservation duration
        double hours = ChronoUnit.HOURS.between(reservation.getStartTime(), reservation.getEndTime());
        if (hours < 1) {
            hours = 1; // Minimum 1 hour
        }
        double amount = hours * parkingHourlyRate;
        
        // Create payment
        Payment payment = new Payment();
        payment.setUser(user);
        payment.setReservation(reservation);
        payment.setAmount(amount);
        payment.setCurrency(currency);
        payment.setPaymentMethod(paymentMethod);
        payment.setStatus(Payment.PaymentStatus.COMPLETED);
        payment.setType(Payment.PaymentType.RESERVATION);
        payment.setPaymentDate(LocalDateTime.now());
        
        // If credit card, store last 4 digits
        if (paymentMethod.equals("CREDIT_CARD") && user.getCreditCardNumber() != null) {
            String cardNumber = user.getCreditCardNumber();
            if (cardNumber.length() >= 4) {
                payment.setCardLastFour(cardNumber.substring(cardNumber.length() - 4));
            }
        }
        
        // Generate transaction ID
        payment.setTransactionId(generateTransactionId());
        
        return paymentRepository.save(payment);
    }
    
