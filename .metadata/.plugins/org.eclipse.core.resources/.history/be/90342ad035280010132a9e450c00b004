            }
        }
        
        // Genera ID transazione
        payment.setTransactionId(generateTransactionId());
        
        return paymentRepository.save(payment);
    }
    
    /**
     * Create a payment that includes both parking and charging (if any)
     * @param userId The user ID
     * @param parkingSpotId The parking spot ID
     * @param paymentMethod The payment method
     * @return The created payment
     */
    public Payment createPaymentForParkingAndCharging(Long userId, Long parkingSpotId, String paymentMethod) {
        User user = userService.findById(userId);
        ParkingSpot parkingSpot = parkingService.getParkingSpotById(parkingSpotId);
        
        // Calcola costo del parcheggio
        LocalDateTime startTime = parkingSpot.getOccupiedSince();
        LocalDateTime endTime = LocalDateTime.now();
        
        double hoursParked = 1.0;
        if (startTime != null) {
            long minutesParked = ChronoUnit.MINUTES.between(startTime, endTime);
            hoursParked = Math.ceil(minutesParked / 60.0);
            if (hoursParked < 1) hoursParked = 1.0; // Minimo 1 ora
        }
        
        double parkingAmount = hoursParked * parkingHourlyRate;
        
        // Trova eventuali richieste di ricarica completate per questo utente e posto
        List<ChargingRequest> completedRequests = chargingRequestRepository.findByUserIdAndParkingSpotIdAndStatus(
                userId, parkingSpotId, ChargingRequest.ChargingStatus.COMPLETED);
        
        double chargingAmount = 0.0;
        ChargingRequest lastCompletedRequest = null;
        
        for (ChargingRequest request : completedRequests) {
            lastCompletedRequest = request; // Salva l'ultima richiesta completata
            
            if (request.getTotalEnergyKwh() != null) {
                chargingAmount += request.getTotalEnergyKwh() * chargingRatePerKwh;
            } else {
                // Calcolo fallback se totalEnergyKwh non è disponibile
                double percentageCharged = request.getTargetPercentage() - request.getInitialPercentage();
                if (user.getBatteryCapacityKw() != null) {
                    double kwhCharged = (percentageCharged / 100.0) * user.getBatteryCapacityKw();
                    chargingAmount += kwhCharged * chargingRatePerKwh;
                }
            }
        }
        
        // Calcola importo totale
        double totalAmount = parkingAmount + chargingAmount;
        
        // Crea il pagamento
        Payment payment = new Payment();
        payment.setUser(user);
        payment.setAmount(totalAmount);
        payment.setCurrency(currency);
        payment.setPaymentMethod(paymentMethod);
        payment.setStatus(Payment.PaymentStatus.COMPLETED);
        
        // Se ci sono richieste di ricarica, associa l'ultima al pagamento e imposta il tipo appropriato
        if (lastCompletedRequest != null) {
            payment.setChargingRequest(lastCompletedRequest);
            payment.setType(Payment.PaymentType.PARKING_AND_CHARGING);
        } else {
            payment.setType(Payment.PaymentType.PARKING_ONLY);
        }
        
        payment.setPaymentDate(LocalDateTime.now());
        
        // Gestione carta di credito
        if (paymentMethod.equals("CREDIT_CARD") && user.getCreditCardNumber() != null) {
            String cardNumber = user.getCreditCardNumber();
            if (cardNumber.length() >= 4) {
                payment.setCardLastFour(cardNumber.substring(cardNumber.length() - 4));
            }
        }
        
        // Genera ID transazione
        payment.setTransactionId(generateTransactionId());
        
        // Log dettagliati
        System.out.println("Parking start time: " + startTime);
        System.out.println("Parking end time: " + endTime);
        System.out.println("Hours parked: " + hoursParked);
        System.out.println("Parking rate: " + parkingHourlyRate);
        System.out.println("Parking amount: " + parkingAmount);
        System.out.println("Charging requests found: " + completedRequests.size());
        System.out.println("Charging amount: " + chargingAmount);
        System.out.println("Total amount to pay: " + totalAmount);
        
        return paymentRepository.save(payment);
    }

    
    
    
