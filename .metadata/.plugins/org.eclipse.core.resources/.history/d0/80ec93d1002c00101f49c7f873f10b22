        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("type", "MWBOT_MAINTENANCE");
            payload.put("botId", mwbot.getBotId());
            payload.put("message", "MWbot " + mwbot.getBotId() + " requires maintenance!");
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("notification/admin/mwbot", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error sending MWbot maintenance notification: " + e.getMessage());
        }
    }
    
    /**
     * Send mwbot low battery notification
     * @param mwbot The MWbot
     */
    public void sendMWbotLowBatteryNotification(MWbot mwbot) {
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("type", "MWBOT_LOW_BATTERY");
            payload.put("botId", mwbot.getBotId());
            payload.put("batteryLevel", mwbot.getBatteryLevel());
            payload.put("message", "MWbot " + mwbot.getBotId() + " has low battery: " + mwbot.getBatteryLevel() + "%");
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("notification/admin/mwbot", payload);
