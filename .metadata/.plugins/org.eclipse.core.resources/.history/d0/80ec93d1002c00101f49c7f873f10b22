        try {
            User user = reservation.getUser();
            
            Map<String, Object> payload = new HashMap<>();
            payload.put("type", "RESERVATION_CONFIRMED");
            payload.put("userId", user.getId());
            payload.put("reservationId", reservation.getId());
            payload.put("message", "Your reservation for spot " + 
                    reservation.getParkingSpot().getSpotNumber() + " has been confirmed!");
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("notification/user/" + user.getId(), payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error sending reservation confirmation notification: " + e.getMessage());
        }
    }
    
