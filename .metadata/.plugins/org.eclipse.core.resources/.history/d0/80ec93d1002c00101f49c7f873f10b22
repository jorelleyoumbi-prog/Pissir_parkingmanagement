        }
    }
    
    /**
     * Send parking spot status notification
     * @param spotId The spot ID
     * @param status The spot status
     */
    public void sendParkingSpotStatusNotification(Long spotId, String status) {
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("type", "SPOT_STATUS_CHANGE");
            payload.put("spotId", spotId);
            payload.put("status", status);
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("notification/parking/status", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error sending parking spot status notification: " + e.getMessage());
        }
    }
    
    /**
     * Send a custom notification to a user
     * @param userId The user ID
     * @param message The notification message
     * @param level The notification level (INFO, WARNING, ERROR)
     */
    public void sendUserNotification(Long userId, String message, String level) {
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("type", "ADMIN_NOTIFICATION");
            payload.put("userId", userId);
            payload.put("message", message);
            payload.put("level", level);
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("notification/user/" + userId, payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error sending user notification: " + e.getMessage());
        }
    }
}