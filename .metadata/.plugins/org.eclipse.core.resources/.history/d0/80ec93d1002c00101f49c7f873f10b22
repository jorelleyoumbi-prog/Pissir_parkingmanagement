package com.parkingsystem.service;

import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import com.parkingsystem.model.User;
import org.springframework.stereotype.Service;

import com.parkingsystem.model.ChargingRequest;
import com.parkingsystem.model.MWbot;
import com.parkingsystem.model.Reservation;
import com.parkingsystem.mqtt.MqttPublisherInterface;

/**
 * Service for sending notifications
 */
@Service
public class NotificationService {

    @Autowired
    private MqttPublisherInterface mqttPublisher;
    
    /**
     * Send charging completion notification
     * @param chargingRequest The charging request
     */
    public void sendChargingCompletionNotification(ChargingRequest chargingRequest) {
        try {
            User user = chargingRequest.getUser();
            
            Map<String, Object> payload = new HashMap<>();
            payload.put("type", "CHARGING_COMPLETED");
            payload.put("userId", user.getId());
            payload.put("requestId", chargingRequest.getId());
            payload.put("message", "Your charging request has been completed! Your vehicle is now charged to " + 
                    chargingRequest.getTargetPercentage() + "%.");
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("notification/user/" + user.getId(), payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error sending charging completion notification: " + e.getMessage());
        }
    }
    
    /**
     * Send charging delay notification
     * @param chargingRequest The charging request
     */
    public void sendChargingDelayNotification(ChargingRequest chargingRequest) {
        try {
            User user = chargingRequest.getUser();
            
            Map<String, Object> payload = new HashMap<>();
            payload.put("type", "CHARGING_DELAYED");
            payload.put("userId", user.getId());
            payload.put("requestId", chargingRequest.getId());
            payload.put("message", "Your charging is taking longer than expected. Current battery level: " + 
                    chargingRequest.getCurrentPercentage() + "%.");
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("notification/user/" + user.getId(), payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error sending charging delay notification: " + e.getMessage());
        }
    }
    
    /**
     * Send reservation confirmation notification
     * @param reservation The reservation
     */
