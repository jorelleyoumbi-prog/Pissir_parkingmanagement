package com.parkingsystem.service;


import java.util.Random;

import org.springframework.scheduling.annotation.EnableScheduling;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;

import com.parkingsystem.config.MqttProperties;
import com.parkingsystem.mqtt.MqttOutboundGateway;

@Service
@EnableScheduling
public class ChargingSimulationService {

    private final MqttOutboundGateway mqttGw;
    private final MqttProperties props;
    private final WebClient webClient;
    private final Random rnd = new Random();

    public ChargingSimulationService(
        MqttOutboundGateway mqttGw,
        MqttProperties props,
        WebClient.Builder wb
    ) {
        this.mqttGw  = mqttGw;
        this.props   = props;
        this.webClient = wb.baseUrl(props.getBrokerUrl()) // non serve in realtà
                           .build();
    }

    /**
     * Viene invocato dal ServiceActivator quando arriva un JSON
     * di richiesta di ricarica (es. { "requestId": 42, ... }).
     */
    public void handleChargingRequest(String payload) {
        // 1) notifica al backend che la ricarica è partita
        webClient.post()
          .uri(props.getTopics().getStarted(), spec -> spec
              .path("/charging-requests/{id}/start")
              .build(extractRequestId(payload)))
          .retrieve().bodyToMono(Void.class).block();

        // 2) pubblica un MQTT "started"
        mqttGw.sendToMqtt(props.getTopics().getStarted(), payload);

        // 3) avvia il ciclo di progress via task schedulato
        scheduleProgress(extractRequestId(payload));
    }

    private Long extractRequestId(String json) {
        // TODO: deserializza con Jackson o simile
        // es. new ObjectMapper().readTree(json).get("requestId").asLong()
        return Long.valueOf(
           json.replaceAll("\\D+","")
        );
    }

    /**
     * Ogni 5 secondi simula un avanzamento per tutte
     * le richieste in corso (semplificato).
     */
    @Scheduled(fixedRate = 5000)
    public void simulateProgress() {
        // In un’implementazione reale terresti traccia
        // delle richieste in corso e invieresti per ciascuna:
        int percent = rnd.nextInt(20) + 1;
        String progressMsg = "{ \"requestId\": 42, \"progress\": " + percent + " }";

        // Notifica backend via REST
        webClient.post()
          .uri("/charging-requests/{id}/progress", 42)
          .retrieve().bodyToMono(Void.class).block();

        // Pubblica MQTT “progress”
        mqttGw.sendToMqtt(props.getTopics().getProgress(), progressMsg);
    }

    /**
     * Puoi aggiungere un altro scheduler per il completamento,
     * oppure riconoscere quando percent>=100 in simulateProgress()
     * e inviare il “completed”:
     */
    @Scheduled(fixedRate = 60000)
    public void simulateCompletion() {
        String completedMsg = "{ \"requestId\": 42 }";
        webClient.post()
          .uri("/charging-requests/{id}/complete", 42)
          .retrieve().bodyToMono(Void.class).block();
        mqttGw.sendToMqtt(props.getTopics().getCompleted(), completedMsg);
    }
}
