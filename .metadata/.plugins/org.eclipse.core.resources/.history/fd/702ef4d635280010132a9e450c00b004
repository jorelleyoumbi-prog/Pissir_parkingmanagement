package com.parkingsystem.backend.controller;

import java.time.format.DateTimeFormatter;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.core.userdetails.UserDetails;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.parkingsystem.backend.dto.ChargingRequestDto;
import com.parkingsystem.backend.exception.BadRequestException;
import com.parkingsystem.backend.exception.UnauthorizedException;
import com.parkingsystem.backend.model.ChargingRequest;
import com.parkingsystem.backend.model.User;
import com.parkingsystem.service.ChargingService;
import com.parkingsystem.service.UserService;

import jakarta.validation.Valid;

/**
 * Controller per le operazioni di ricarica
 */
@RestController
@RequestMapping("/api/charging")
public class ChargingController {

    @Autowired
    private ChargingService chargingService;
    
    @Autowired
    private UserService userService;
    
    private final DateTimeFormatter dateTimeFormatter = DateTimeFormatter.ISO_LOCAL_DATE_TIME;
    
    /**
     * Crea una nuova richiesta di ricarica
     * @param requestBody I dettagli della richiesta di ricarica
     * @return Risposta con la richiesta di ricarica creata
     */
    @PostMapping("/request")
    public ResponseEntity<?> createChargingRequest(@Valid @RequestBody Map<String, Object> requestBody) {
        try {
            // Ottieni l'utente autenticato
            Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
            UserDetails userDetails = (UserDetails) authentication.getPrincipal();
            User user = userService.findByUsername(userDetails.getUsername());
            
            // Estrai i parametri dalla richiesta
            Long parkingSpotId = Long.valueOf(requestBody.get("parkingSpotId").toString());
            Integer initialPercentage = Integer.valueOf(requestBody.get("initialPercentage").toString());
            Integer targetPercentage = Integer.valueOf(requestBody.get("targetPercentage").toString());
            boolean notificationRequested = requestBody.containsKey("notificationRequested") ? 
                    Boolean.valueOf(requestBody.get("notificationRequested").toString()) : false;
            
            // Verifica se l'utente ha già una richiesta di ricarica attiva
            Optional<ChargingRequest> existingRequest = chargingService.getActiveChargingRequestByUserId(user.getId());
            if (existingRequest.isPresent()) {
                return ResponseEntity
                        .badRequest()
                        .body(Map.of(
                                "error", "Hai già una richiesta di ricarica attiva", 
                                "requestId", existingRequest.get().getId()));
            }
            
            // Crea la richiesta di ricarica
            ChargingRequest chargingRequest = chargingService.createChargingRequest(
                    user.getId(), parkingSpotId, initialPercentage, targetPercentage, notificationRequested);
            
            // Restituisci la richiesta di ricarica creata come DTO
            return ResponseEntity.status(HttpStatus.CREATED).body(convertToDto(chargingRequest));
        } catch (BadRequestException e) {
            return ResponseEntity
                    .badRequest()
                    .body(Map.of("error", e.getMessage()));
        } catch (Exception e) {
            return ResponseEntity
                    .status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Errore durante la creazione della richiesta di ricarica: " + e.getMessage()));
        }
    }
    
    /**
     * Ottieni una richiesta di ricarica per ID
     * @param id L'ID della richiesta di ricarica
     * @return Risposta con la richiesta di ricarica
     */
    @GetMapping("/{id}")
    public ResponseEntity<?> getChargingRequest(@PathVariable Long id) {
        try {
            // Ottieni l'utente autenticato
            Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
            UserDetails userDetails = (UserDetails) authentication.getPrincipal();
            User user = userService.findByUsername(userDetails.getUsername());
            
            // Ottieni la richiesta di ricarica
            ChargingRequest chargingRequest = chargingService.getChargingRequestById(id);
            
            // Verifica se l'utente ha il permesso di accedere a questa richiesta
            boolean isAdmin = user.getRole() == User.UserRole.ADMIN;
            boolean isOwner = chargingRequest.getUser().getId().equals(user.getId());
            
            if (!isAdmin && !isOwner) {
                throw new UnauthorizedException("Non sei autorizzato ad accedere a questa richiesta di ricarica");
            }
            
            return ResponseEntity.ok(convertToDto(chargingRequest));
        } catch (UnauthorizedException e) {
            return ResponseEntity
                    .status(HttpStatus.FORBIDDEN)
                    .body(Map.of("error", e.getMessage()));
        } catch (Exception e) {
            return ResponseEntity
                    .status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Errore nel recuperare la richiesta di ricarica: " + e.getMessage()));
        }
    }
    
    /**
     * Ottieni le richieste di ricarica per l'utente corrente
     * @return Risposta con le richieste di ricarica
     */
    @GetMapping("/user")
    public ResponseEntity<?> getUserChargingRequests() {
        try {
            // Ottieni l'utente autenticato
            Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
            UserDetails userDetails = (UserDetails) authentication.getPrincipal();
            User user = userService.findByUsername(userDetails.getUsername());
            
            // Ottieni le richieste di ricarica
            List<ChargingRequest> chargingRequests = chargingService.getChargingRequestsByUserId(user.getId());
            
            List<ChargingRequestDto> chargingRequestDtos = chargingRequests.stream()
                    .map(this::convertToDto)
                    .collect(Collectors.toList());
            
            return ResponseEntity.ok(chargingRequestDtos);
        } catch (Exception e) {
            return ResponseEntity
                    .status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Errore nel recuperare le richieste di ricarica: " + e.getMessage()));
        }
    }
    
    /**
     * Annulla una richiesta di ricarica
     * @param id L'ID della richiesta di ricarica
     * @return Risposta con la richiesta di ricarica annullata
     */
    @PostMapping("/{id}/cancel")
    public ResponseEntity<?> cancelChargingRequest(@PathVariable Long id) {
        try {
            // Ottieni l'utente autenticato
            Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
            UserDetails userDetails = (UserDetails) authentication.getPrincipal();
            User user = userService.findByUsername(userDetails.getUsername());
            
            // Ottieni la richiesta di ricarica
            ChargingRequest chargingRequest = chargingService.getChargingRequestById(id);
            
            // Verifica se l'utente ha il permesso di annullare questa richiesta
            boolean isAdmin = user.getRole() == User.UserRole.ADMIN;
            boolean isOwner = chargingRequest.getUser().getId().equals(user.getId());
            
            if (!isAdmin && !isOwner) {
                throw new UnauthorizedException("Non sei autorizzato ad annullare questa richiesta di ricarica");
            }
            
            // Annulla la richiesta di ricarica
            ChargingRequest cancelledRequest = chargingService.cancelChargingRequest(id);
            
            return ResponseEntity.ok(convertToDto(cancelledRequest));
        } catch (UnauthorizedException e) {
            return ResponseEntity
                    .status(HttpStatus.FORBIDDEN)
                    .body(Map.of("error", e.getMessage()));
        } catch (BadRequestException e) {
            return ResponseEntity
                    .badRequest()
                    .body(Map.of("error", e.getMessage()));
        } catch (Exception e) {
            return ResponseEntity
                    .status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Errore durante l'annullamento della richiesta di ricarica: " + e.getMessage()));
        }
    }
    
    /**
     * Converte una richiesta di ricarica in DTO
     * @param chargingRequest La richiesta di ricarica
     * @return Il DTO della richiesta di ricarica
     */
    private ChargingRequestDto convertToDto(ChargingRequest chargingRequest) {
        ChargingRequestDto dto = new ChargingRequestDto();
        
        // Imposta i dettagli della richiesta di ricarica nel DTO
        dto.setId(chargingRequest.getId());
        dto.setUserId(chargingRequest.getUser().getId());
        dto.setParkingSpotId(chargingRequest.getParkingSpot().getId());
        dto.setSpotNumber(chargingRequest.getParkingSpot().getSpotNumber());
        dto.setStatus(chargingRequest.getStatus().toString());
        dto.setInitialPercentage(chargingRequest.getInitialPercentage());
        dto.setCurrentPercentage(chargingRequest.getCurrentPercentage());
        dto.setTargetPercentage(chargingRequest.getTargetPercentage());
        
        if (chargingRequest.getEstimatedStartTime() != null) {
            dto.setEstimatedStartTime(chargingRequest.getEstimatedStartTime().format(dateTimeFormatter));
        }
        
        if (chargingRequest.getChargingStartTime() != null) {
            dto.setChargingStartTime(chargingRequest.getChargingStartTime().format(dateTimeFormatter));
        }
        
        if (chargingRequest.getEstimatedCompletionTime() != null) {
            dto.setEstimatedCompletionTime(chargingRequest.getEstimatedCompletionTime().format(dateTimeFormatter));
        }
        
        if (chargingRequest.getChargingCompletionTime() != null) {
            dto.setChargingCompletionTime(chargingRequest.getChargingCompletionTime().format(dateTimeFormatter));
        }
        
        dto.setQueuePosition(chargingRequest.getQueuePosition());
        dto.setTotalEnergyKwh(chargingRequest.getTotalEnergyKwh());
        dto.setNotificationRequested(chargingRequest.isNotificationRequested());
        
        if (chargingRequest.getCreatedAt() != null) {
            dto.setCreatedAt(chargingRequest.getCreatedAt().format(dateTimeFormatter));
        }
        
        return dto;
    }
    
    /**
     * Richiedi una ricarica aggiuntiva dopo che la precedente è stata completata
     * @param id L'ID della richiesta completata
     * @param requestBody I dettagli della nuova richiesta
     * @return Risposta con la nuova richiesta di ricarica
     */
    @PostMapping("/{id}/additional")
    public ResponseEntity<?> requestAdditionalCharging(@PathVariable Long id, @RequestBody Map<String, Object> requestBody) {
        try {
            // Ottieni l'utente autenticato
            Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
            UserDetails userDetails = (UserDetails) authentication.getPrincipal();
            User user = userService.findByUsername(userDetails.getUsername());
            
            // Ottieni la richiesta di ricarica originale
            ChargingRequest originalRequest = chargingService.getChargingRequestById(id);
            
            // Verifica se l'utente ha il permesso di accedere a questa richiesta
            boolean isAdmin = user.getRole() == User.UserRole.ADMIN;
            boolean isOwner = originalRequest.getUser().getId().equals(user.getId());
            
            if (!isAdmin && !isOwner) {
                throw new UnauthorizedException("Non sei autorizzato ad accedere a questa richiesta di ricarica");
            }
            
            // Verifica se la richiesta originale è stata completata
            if (originalRequest.getStatus() != ChargingRequest.ChargingStatus.COMPLETED) {
                throw new BadRequestException("Impossibile richiedere una ricarica aggiuntiva per una richiesta non completata");
            }
            
            // Estrai i parametri dalla richiesta
            Integer targetPercentage = Integer.valueOf(requestBody.get("targetPercentage").toString());
            boolean notificationRequested = requestBody.containsKey("notificationRequested") ? 
                    Boolean.valueOf(requestBody.get("notificationRequested").toString()) : false;
            
            // Richiedi una ricarica aggiuntiva (crea una nuova richiesta con lo stesso posto)
            ChargingRequest newRequest = chargingService.createAdditionalChargingRequest(
                    originalRequest, targetPercentage, notificationRequested);
            
            return ResponseEntity.status(HttpStatus.CREATED).body(convertToDto(newRequest));
        } catch (UnauthorizedException e) {
            return ResponseEntity
                    .status(HttpStatus.FORBIDDEN)
                    .body(Map.of("error", e.getMessage()));
        } catch (BadRequestException e) {
            return ResponseEntity
                    .badRequest()
                    .body(Map.of("error", e.getMessage()));
        } catch (Exception e) {
            return ResponseEntity
                    .status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Errore durante la richiesta di una ricarica aggiuntiva: " + e.getMessage()));
        }
    }
}
