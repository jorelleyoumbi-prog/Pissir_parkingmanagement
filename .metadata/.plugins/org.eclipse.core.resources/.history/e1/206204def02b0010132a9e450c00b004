    /**
     * Process a message based on topic
     * @param topic The MQTT topic
     * @param message The MQTT message
     */
    public void processMessage(String topic, String message) {
        // Log per debug
        System.out.println("[MQTT] Received message on topic: " + topic);
        System.out.println("[MQTT] Message: " + message);
        
        // Gestione dei vari topic
        if (topic.matches("parkingsystem/parking/spots/\\d+/status")) {
            handleParkingSensorUpdate(message, topic);
        } else if (topic.matches("parkingsystem/mwbot/charging/\\d+/progress")) {
            handleChargingProgressUpdate(message, topic);
        } else if (topic.matches("parkingsystem/mwbot/charging/\\d+/status")) {
            handleChargingStatusUpdate(message, topic);
        } else if (topic.startsWith("parkingsystem/mwbot/status/")) {
            handleMWbotStatusUpdate(message);
        } else if (topic.startsWith("parkingsystem/mwbot/battery/")) {
            handleMWbotBatteryUpdate(message);
        } else if (topic.startsWith("parkingsystem/mwbot/maintenance/")) {
            handleMWbotMaintenance(message);
        } else if (topic.equals("parkingsystem/parking/entrance")) {
            handleParkingEntranceEvent(message);
        } else if (topic.equals("parkingsystem/parking/exit")) {
            handleParkingExitEvent(message);
        } else {
            System.out.println("[MQTT] Unhandled topic: " + topic);
        }
    }
}