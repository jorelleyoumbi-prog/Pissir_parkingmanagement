package com.parkingsystem.backend.service;

import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import com.parkingsystem.backend.exception.BadRequestException;
import com.parkingsystem.backend.exception.ResourceNotFoundException;
import com.parkingsystem.backend.model.ChargingRequest;
import com.parkingsystem.backend.model.MWbot;
import com.parkingsystem.backend.model.ParkingSpot;
import com.parkingsystem.backend.model.User;
import com.parkingsystem.backend.repository.ChargingRequestRepository;
import com.parkingsystem.mqtt.MqttPublisherInterface;

/**
 * Service for charging operations
 */
@Service
public class ChargingService {

    @Autowired
    private ChargingRequestRepository chargingRequestRepository;
    
    @Autowired
    private UserService userService;
    
    @Autowired
    private ParkingService parkingService;
    
    @Autowired
    private MWbotService mwbotService;
    
    @Autowired
    private NotificationService notificationService;
    
    @Autowired
    private MqttPublisherInterface mqttPublisher;
    
    @Value("${mwbot.charging.rate.kw:11.0}")
    private double mwbotChargingRateKw;
    
    /**
     * Create a new charging request
     * @param userId The user ID
     * @param parkingSpotId The parking spot ID
     * @param initialPercentage The initial battery percentage
     * @param targetPercentage The target battery percentage
     * @param notificationRequested Whether to send a notification when charging is complete
     * @return The created charging request
     */
    public ChargingRequest createChargingRequest(Long userId, Long parkingSpotId, Integer initialPercentage, 
            Integer targetPercentage, boolean notificationRequested) {
        
        // Validate input
        if (initialPercentage < 0 || initialPercentage > 100) {
            throw new BadRequestException("Initial percentage must be between 0 and 100");
        }
        
        if (targetPercentage < 0 || targetPercentage > 100) {
            throw new BadRequestException("Target percentage must be between 0 and 100");
        }
        
        if (initialPercentage >= targetPercentage) {
            throw new BadRequestException("Target percentage must be greater than initial percentage");
        }
        
        // Get user and parking spot
        User user = userService.findById(userId);
        ParkingSpot parkingSpot = parkingService.getParkingSpotById(parkingSpotId);
        
        // Check if the parking spot supports charging
        if (!parkingSpot.isChargingAvailable()) {
            throw new BadRequestException("Parking spot does not support charging");
        }
        
        // Check if the parking spot is occupied
        boolean isTestEnvironment = System.getProperty("spring.profiles.active", "").contains("test");
        if (!parkingSpot.isOccupied() && !isTestEnvironment) {
            throw new BadRequestException("Parking spot is not occupied");
        }
        
        // Check if there's already an active charging request for this spot
        if (chargingRequestRepository.existsByParkingSpotIdAndStatusIn(
                parkingSpotId, 
                List.of(ChargingRequest.ChargingStatus.PENDING, ChargingRequest.ChargingStatus.IN_PROGRESS))) {
            throw new BadRequestException("Parking spot already has an active charging request");
        }
        
        // Create the charging request
        ChargingRequest chargingRequest = new ChargingRequest();
        chargingRequest.setUser(user);
        chargingRequest.setParkingSpot(parkingSpot);
        chargingRequest.setInitialPercentage(initialPercentage);
        chargingRequest.setTargetPercentage(targetPercentage);
        chargingRequest.setCurrentPercentage(initialPercentage);
        chargingRequest.setStatus(ChargingRequest.ChargingStatus.PENDING);
        chargingRequest.setNotificationRequested(notificationRequested);
        chargingRequest.setNotificationSent(false);
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Determine queue position
        List<ChargingRequest> pendingRequests = chargingRequestRepository.findByStatusOrderByCreatedAtAsc(ChargingRequest.ChargingStatus.PENDING);
        int queuePosition = pendingRequests.indexOf(chargingRequest) + 1;
        chargingRequest.setQueuePosition(queuePosition);
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Publish charging request via MQTT
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("requestId", chargingRequest.getId());
            payload.put("userId", userId);
            payload.put("parkingSpotId", parkingSpotId);
            payload.put("initialPercentage", initialPercentage);
            payload.put("targetPercentage", targetPercentage);
            payload.put("status", chargingRequest.getStatus().toString());
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("charging/request/created", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error publishing MQTT message: " + e.getMessage());
        }
        
        // Attempt to assign an available MWbot
        assignMWbotToNextChargingRequest();
        
        return chargingRequest;
    }
    
    /**
     * Get a charging request by ID
     * @param id The charging request ID
     * @return The charging request
     */
    public ChargingRequest getChargingRequestById(Long id) {
        return chargingRequestRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Charging request not found with id: " + id));
    }
    
    /**
     * Get charging requests by user ID
     * @param userId The user ID
     * @return List of charging requests
     */
    public List<ChargingRequest> getChargingRequestsByUserId(Long userId) {
        return chargingRequestRepository.findByUserIdOrderByCreatedAtDesc(userId);
    }
    
    /**
     * Get active charging request by user ID
     * @param userId The user ID
     * @return Optional charging request
     */
    public Optional<ChargingRequest> getActiveChargingRequestByUserId(Long userId) {
        List<ChargingRequest> requests = chargingRequestRepository.findByUserIdAndStatusIn(
                userId, 
                List.of(ChargingRequest.ChargingStatus.PENDING, ChargingRequest.ChargingStatus.IN_PROGRESS));
        
        // Restituisci il primo elemento della lista se presente, altrimenti Optional vuoto
        return requests.isEmpty() ? Optional.empty() : Optional.of(requests.get(0));
    }
    
    /**
     * Get all active charging requests (pending or in progress).
     * @return List of active charging requests
     */
    public List<ChargingRequest> getActiveChargingRequests() {
        // Trova tutte le richieste di ricarica che sono in stato PENDING o IN_PROGRESS
        return chargingRequestRepository.findByStatusIn(
                List.of(ChargingRequest.ChargingStatus.PENDING, ChargingRequest.ChargingStatus.IN_PROGRESS));
    }

    
    /**
     * Cancel a charging request
     * @param id The charging request ID
     * @return The cancelled charging request
     */
    public ChargingRequest cancelChargingRequest(Long id) {
        ChargingRequest chargingRequest = getChargingRequestById(id);
        
        // Can only cancel if the status is PENDING or QUEUED
        if (chargingRequest.getStatus() != ChargingRequest.ChargingStatus.PENDING && 
                chargingRequest.getStatus() != ChargingRequest.ChargingStatus.QUEUED) {
            throw new BadRequestException("Cannot cancel charging request with status: " + chargingRequest.getStatus());
        }
        
        // If this request was assigned to an MWbot, free the MWbot
        List<MWbot> assignedBots = mwbotService.getMWbotsByChargingRequestId(id);
        for (MWbot bot : assignedBots) {
            bot.setStatus(MWbot.BotStatus.AVAILABLE);
            bot.setCurrentChargingRequest(null);
            mwbotService.updateMWbot(bot.getId(), bot);
        }
        
        // Cancel the request
        chargingRequest.setStatus(ChargingRequest.ChargingStatus.CANCELLED);
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Publish cancellation via MQTT
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("requestId", id);
            payload.put("status", "CANCELLED");
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("charging/request/" + id + "/cancelled", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error publishing MQTT message: " + e.getMessage());
        }
        
        // Reassign queue positions for remaining requests
        updateQueuePositions();
        
        // Try to assign an MWbot to the next request in queue
        assignMWbotToNextChargingRequest();
        
        return chargingRequest;
    }
    
    /**
     * Start charging a request
     * @param requestId The charging request ID
     * @param mwbotId The MWbot ID
     * @return The updated charging request
     */
    public ChargingRequest startCharging(Long requestId, Long mwbotId) {
        ChargingRequest chargingRequest = getChargingRequestById(requestId);
        
        // Can only start if the status is PENDING or QUEUED
        if (chargingRequest.getStatus() != ChargingRequest.ChargingStatus.PENDING && 
                chargingRequest.getStatus() != ChargingRequest.ChargingStatus.QUEUED) {
            throw new BadRequestException("Cannot start charging request with status: " + chargingRequest.getStatus());
        }
        
        // Get MWbot
        MWbot mwbot = mwbotService.getMWbotById(mwbotId);
        
        // Check if MWbot is available
        if (mwbot.getStatus() != MWbot.BotStatus.AVAILABLE) {
            throw new BadRequestException("MWbot is not available");
        }
        
        // Assign MWbot to the charging request
        mwbot.setStatus(MWbot.BotStatus.BUSY);
        mwbot.setCurrentChargingRequest(chargingRequest);
        mwbotService.updateMWbot(mwbotId, mwbot);
        
        // Update charging request
        chargingRequest.setStatus(ChargingRequest.ChargingStatus.IN_PROGRESS);
        chargingRequest.setChargingStartTime(LocalDateTime.now());
        
        // Calculate estimated completion time based on target percentage, initial percentage, and MWbot charging rate
        if (chargingRequest.getUser().getBatteryCapacityKw() != null) {
            double batteryCapacityKwh = chargingRequest.getUser().getBatteryCapacityKw();
            double percentageToCharge = chargingRequest.getTargetPercentage() - chargingRequest.getInitialPercentage();
            double kwhToCharge = (percentageToCharge / 100.0) * batteryCapacityKwh;
            double hoursToCharge = kwhToCharge / mwbotChargingRateKw;
            
            // Convert to minutes and round up
            long minutesToCharge = (long) Math.ceil(hoursToCharge * 60);
            
            chargingRequest.setEstimatedCompletionTime(LocalDateTime.now().plusMinutes(minutesToCharge));
        }
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Publish charging start via MQTT
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("requestId", requestId);
            payload.put("mwbotId", mwbotId);
            payload.put("status", "IN_PROGRESS");
            payload.put("initialPercentage", chargingRequest.getInitialPercentage());
            payload.put("targetPercentage", chargingRequest.getTargetPercentage());
            payload.put("estimatedCompletionTime", chargingRequest.getEstimatedCompletionTime() != null ? 
                    chargingRequest.getEstimatedCompletionTime().toString() : null);
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("charging/request/" + requestId + "/started", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error publishing MQTT message: " + e.getMessage());
        }
        
        return chargingRequest;
    }
    
    /**
     * Update charging progress
     * @param requestId The charging request ID
     * @param currentPercentage The current battery percentage
     * @return The updated charging request
     */
    public ChargingRequest updateChargingProgress(Long requestId, Integer currentPercentage) {
        ChargingRequest chargingRequest = getChargingRequestById(requestId);
        
        // Can only update if the status is IN_PROGRESS
        if (chargingRequest.getStatus() != ChargingRequest.ChargingStatus.IN_PROGRESS) {
            throw new BadRequestException("Cannot update charging request with status: " + chargingRequest.getStatus());
        }
        
        // Validate input
        if (currentPercentage < chargingRequest.getInitialPercentage() || currentPercentage > chargingRequest.getTargetPercentage()) {
            throw new BadRequestException("Current percentage must be between initial and target percentage");
        }
        
        // Update charging request
        chargingRequest.setCurrentPercentage(currentPercentage);
        
        // Check if charging is complete
        if (currentPercentage >= chargingRequest.getTargetPercentage()) {
            completeCharging(requestId);
            return chargingRequest;
        }
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Publish charging update via MQTT
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("requestId", requestId);
            payload.put("currentPercentage", currentPercentage);
            payload.put("targetPercentage", chargingRequest.getTargetPercentage());
            payload.put("status", "IN_PROGRESS");
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("charging/request/" + requestId + "/progress", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error publishing MQTT message: " + e.getMessage());
        }
        
        return chargingRequest;
    }
    
    /**
     * Complete charging
     * @param requestId The charging request ID
     * @return The completed charging request
     */
    public ChargingRequest completeCharging(Long requestId) {
        ChargingRequest chargingRequest = getChargingRequestById(requestId);
        
        // Can only complete if the status is IN_PROGRESS
        if (chargingRequest.getStatus() != ChargingRequest.ChargingStatus.IN_PROGRESS) {
            throw new BadRequestException("Cannot complete charging request with status: " + chargingRequest.getStatus());
        }
        
        // Update charging request
        chargingRequest.setStatus(ChargingRequest.ChargingStatus.COMPLETED);
        chargingRequest.setChargingCompletionTime(LocalDateTime.now());
        
        // Calculate total energy used
        if (chargingRequest.getUser().getBatteryCapacityKw() != null) {
            double batteryCapacityKwh = chargingRequest.getUser().getBatteryCapacityKw();
            double percentageCharged = chargingRequest.getTargetPercentage() - chargingRequest.getInitialPercentage();
            double kwhCharged = (percentageCharged / 100.0) * batteryCapacityKwh;
            
            chargingRequest.setTotalEnergyKwh(kwhCharged);
        }
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Free up the assigned MWbot
        List<MWbot> assignedBots = mwbotService.getMWbotsByChargingRequestId(requestId);
        for (MWbot bot : assignedBots) {
            bot.setStatus(MWbot.BotStatus.AVAILABLE);
            bot.setCurrentChargingRequest(null);
            mwbotService.updateMWbot(bot.getId(), bot);
        }
        
        // Publish charging completion via MQTT
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("requestId", requestId);
            payload.put("status", "COMPLETED");
            payload.put("finalPercentage", chargingRequest.getTargetPercentage());
            payload.put("totalEnergy", chargingRequest.getTotalEnergyKwh());
            payload.put("timestamp", LocalDateTime.now().toString());
            
            mqttPublisher.publish("charging/request/" + requestId + "/completed", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error publishing MQTT message: " + e.getMessage());
        }
        
        // Send notification if requested
        if (chargingRequest.isNotificationRequested() && !chargingRequest.isNotificationSent()) {
            notificationService.sendChargingCompletionNotification(chargingRequest);
            chargingRequest.setNotificationSent(true);
            chargingRequest = chargingRequestRepository.save(chargingRequest);
        }
        
        // Try to assign an MWbot to the next request in queue
        assignMWbotToNextChargingRequest();
        
        return chargingRequest;
    }
    
    /**
     * Assign an MWbot to the next charging request in queue
     */
    public void assignMWbotToNextChargingRequest() {
        // Get the next pending request
        List<ChargingRequest> pendingRequests = chargingRequestRepository.findByStatusOrderByCreatedAtAsc(ChargingRequest.ChargingStatus.PENDING);
        
        if (pendingRequests.isEmpty()) {
            return;
        }
        
        ChargingRequest nextRequest = pendingRequests.get(0);
        
        // Get an available MWbot
        List<MWbot> availableBots = mwbotService.getAvailableMWbots();
        
        if (availableBots.isEmpty()) {
            return;
        }
        
        // Assign the MWbot to the request
        MWbot bot = availableBots.get(0);
        startCharging(nextRequest.getId(), bot.getId());
    }
    
    /**
     * Update queue positions for pending requests
     */
    private void updateQueuePositions() {
        List<ChargingRequest> pendingRequests = chargingRequestRepository.findByStatusOrderByCreatedAtAsc(ChargingRequest.ChargingStatus.PENDING);
        
        for (int i = 0; i < pendingRequests.size(); i++) {
            ChargingRequest request = pendingRequests.get(i);
            request.setQueuePosition(i + 1);
            chargingRequestRepository.save(request);
        }
    }
    
    /**
     * Scheduled task to check for overdue charging requests
     */
    @Scheduled(fixedRate = 60000) // every minute
    public void checkOverdueRequests() {
        LocalDateTime now = LocalDateTime.now();
        
        // Get all in-progress requests
        List<ChargingRequest> inProgressRequests = chargingRequestRepository.findByStatus(ChargingRequest.ChargingStatus.IN_PROGRESS);
        
        for (ChargingRequest request : inProgressRequests) {
            // If estimated completion time is past, check if we need to send a notification
            if (request.getEstimatedCompletionTime() != null && now.isAfter(request.getEstimatedCompletionTime())) {
                // If the request is taking longer than expected, send a notification
                if (request.isNotificationRequested() && !request.isNotificationSent()) {
                    notificationService.sendChargingDelayNotification(request);
                }
            }
        }
        
        // Check for completed requests that need notifications
        List<ChargingRequest> completedRequests = chargingRequestRepository.findByStatusAndNotificationRequestedAndNotificationSent(
                ChargingRequest.ChargingStatus.COMPLETED, true, false);
        
        for (ChargingRequest request : completedRequests) {
            notificationService.sendChargingCompletionNotification(request);
            request.setNotificationSent(true);
            chargingRequestRepository.save(request);
        }
    }
    
    /**
     * Update battery percentage
     * @param requestId The charging request ID
     * @param percentage The current battery percentage
     * @return The updated charging request
     */
    public ChargingRequest updateBatteryPercentage(Long requestId, int percentage) {
        ChargingRequest chargingRequest = getChargingRequestById(requestId);
        
        // Can only update if the status is IN_PROGRESS
        if (chargingRequest.getStatus() != ChargingRequest.ChargingStatus.IN_PROGRESS) {
            throw new BadRequestException("Cannot update charging request with status: " + chargingRequest.getStatus());
        }
        
        // Validate input
        if (percentage < chargingRequest.getInitialPercentage() || percentage > chargingRequest.getTargetPercentage()) {
            throw new BadRequestException("Percentage must be between initial and target percentage");
        }
        
        // Update charging request
        chargingRequest.setCurrentPercentage(percentage);
        
        // Check if charging is complete
        if (percentage >= chargingRequest.getTargetPercentage()) {
            return completeChargingRequest(requestId);
        }
        
        return chargingRequestRepository.save(chargingRequest);
    }

    /**
     * Complete a charging request
     * @param requestId The charging request ID
     * @return The completed charging request
     */
    public ChargingRequest completeChargingRequest(Long requestId) {
        ChargingRequest chargingRequest = getChargingRequestById(requestId);
        
        // Can only complete if the status is IN_PROGRESS
        if (chargingRequest.getStatus() != ChargingRequest.ChargingStatus.IN_PROGRESS) {
            throw new BadRequestException("Cannot complete charging request with status: " + chargingRequest.getStatus());
        }
        
        // Update charging request
        chargingRequest.setStatus(ChargingRequest.ChargingStatus.COMPLETED);
        chargingRequest.setChargingCompletionTime(LocalDateTime.now());
        chargingRequest.setCurrentPercentage(chargingRequest.getTargetPercentage());
        
        // Calculate total energy used
        if (chargingRequest.getUser().getBatteryCapacityKw() != null) {
            double batteryCapacityKwh = chargingRequest.getUser().getBatteryCapacityKw();
            double percentageCharged = chargingRequest.getTargetPercentage() - chargingRequest.getInitialPercentage();
            double kwhCharged = (percentageCharged / 100.0) * batteryCapacityKwh;
            
            chargingRequest.setTotalEnergyKwh(kwhCharged);
        }
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Free up the assigned MWbot
        List<MWbot> assignedBots = mwbotService.getMWbotsByChargingRequestId(requestId);
        for (MWbot bot : assignedBots) {
            bot.setStatus(MWbot.BotStatus.AVAILABLE);
            bot.setCurrentChargingRequest(null);
            mwbotService.updateMWbot(bot.getId(), bot);
        }
        
        // Send notification if requested
        if (chargingRequest.isNotificationRequested() && !chargingRequest.isNotificationSent()) {
            notificationService.sendChargingCompletionNotification(chargingRequest);
            chargingRequest.setNotificationSent(true);
            chargingRequest = chargingRequestRepository.save(chargingRequest);
        }
        
        return chargingRequest;
    }
    
    /**
     * Crea una richiesta di ricarica aggiuntiva dopo che la prima è stata completata
     * @param originalRequest La richiesta di ricarica originale completata
     * @param targetPercentage La nuova percentuale target
     * @param notificationRequested Se richiedere una notifica
     * @return La nuova richiesta di ricarica
     */
    public ChargingRequest createAdditionalChargingRequest(ChargingRequest originalRequest, 
            Integer targetPercentage, boolean notificationRequested) {
        
        // Validate input
        if (targetPercentage <= originalRequest.getTargetPercentage()) {
            throw new BadRequestException("New target percentage must be greater than the previous target percentage");
        }
        
        if (targetPercentage < 0 || targetPercentage > 100) {
            throw new BadRequestException("Target percentage must be between 0 and 100");
        }
        
        // Verify that the original request is completed
        if (originalRequest.getStatus() != ChargingRequest.ChargingStatus.COMPLETED) {
            throw new BadRequestException("Original charging request must be completed");
        }
        
        // Create the new charging request
        ChargingRequest chargingRequest = new ChargingRequest();
        chargingRequest.setUser(originalRequest.getUser());
        chargingRequest.setParkingSpot(originalRequest.getParkingSpot());
        chargingRequest.setInitialPercentage(originalRequest.getTargetPercentage());
        chargingRequest.setTargetPercentage(targetPercentage);
        chargingRequest.setCurrentPercentage(originalRequest.getTargetPercentage());
        chargingRequest.setStatus(ChargingRequest.ChargingStatus.PENDING);
        chargingRequest.setNotificationRequested(notificationRequested);
        chargingRequest.setNotificationSent(false);
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Determine queue position
        List<ChargingRequest> pendingRequests = chargingRequestRepository.findByStatusOrderByCreatedAtAsc(ChargingRequest.ChargingStatus.PENDING);
        int queuePosition = pendingRequests.indexOf(chargingRequest) + 1;
        chargingRequest.setQueuePosition(queuePosition);
        
        chargingRequest = chargingRequestRepository.save(chargingRequest);
        
        // Publish charging request via MQTT
        try {
            Map<String, Object> payload = new HashMap<>();
            payload.put("requestId", chargingRequest.getId());
            payload.put("userId", chargingRequest.getUser().getId());
            payload.put("parkingSpotId", chargingRequest.getParkingSpot().getId());
            payload.put("initialPercentage", chargingRequest.getInitialPercentage());
            payload.put("targetPercentage", chargingRequest.getTargetPercentage());
            payload.put("status", chargingRequest.getStatus().toString());
            payload.put("timestamp", LocalDateTime.now().toString());
            payload.put("isAdditionalRequest", true);
            
            mqttPublisher.publish("charging/request/created", payload);
        } catch (Exception e) {
            // Log exception but don't stop the operation
            System.err.println("Error publishing MQTT message: " + e.getMessage());
        }
        
        // Attempt to assign an available MWbot
        assignMWbotToNextChargingRequest();
        
        return chargingRequest;
    }
}