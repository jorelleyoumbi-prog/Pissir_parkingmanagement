<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Parking System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/styles.css}">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="#">Smart Parking System</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" th:href="@{/dashboard}">Dashboard</a>
                    </li>
                    <li class="nav-item" th:if="${user.premium}">
                        <a class="nav-link" th:href="@{/booking}">Prenota</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" th:href="@{/charging}">Ricarica</a>
                    </li>
                </ul>
                <div class="navbar-text text-white me-3">
                    Benvenuto, <span th:text="${user.fullName}">Utente</span>
                </div>
                <a class="btn btn-outline-light" th:href="@{/logout}">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="alert alert-danger" th:if="${error}" th:text="${error}"></div>
        
        <h1 class="mb-4">Dashboard</h1>
        
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Le mie richieste di ricarica</h5>
                    </div>
                    <div class="card-body">
                        <div th:if="${chargingRequests == null || #arrays.length(chargingRequests) == 0}">
                            <p>Non hai ancora richieste di ricarica.</p>
                        </div>
                        <div th:if="${chargingRequests != null && #arrays.length(chargingRequests) > 0}">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Posto</th>
                                        <th>Stato</th>
                                        <th>Percentuale</th>
                                        <th>Creata il</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr th:each="req : ${chargingRequests}">
                                        <td th:text="${req.id}"></td>
                                        <td th:text="${req.spotNumber}"></td>
                                        <td th:text="${req.status}"></td>
                                        <td th:text="${req.currentPercentage} + '% / ' + ${req.targetPercentage} + '%'"></td>
                                        <td th:text="${req.createdAt}"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <div class="card mb-4" th:if="${user.premium}">
                    <div class="card-header">
                        <h5>Le mie prenotazioni</h5>
                    </div>
                    <div class="card-body">
                        <div th:if="${reservations == null || #arrays.length(reservations) == 0}">
                            <p>Non hai ancora prenotazioni.</p>
                        </div>
                        <div th:if="${reservations != null && #arrays.length(reservations) > 0}">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Posto</th>
                                        <th>Inizio</th>
                                        <th>Fine</th>
                                        <th>Stato</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr th:each="res : ${reservations}">
                                        <td th:text="${res.id}"></td>
                                        <td th:text="${res.parkingSpotNumber}"></td>
                                        <td th:text="${res.startTime}"></td>
                                        <td th:text="${res.endTime}"></td>
                                        <td th:text="${res.status}"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Ultimi pagamenti</h5>
                    </div>
                    <div class="card-body">
                        <div th:if="${payments == null || #arrays.length(payments) == 0}">
                            <p>Non hai ancora effettuato pagamenti.</p>
                        </div>
                        <div th:if="${payments != null && #arrays.length(payments) > 0}">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Data</th>
                                        <th>Tipo</th>
                                        <th>Importo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr th:each="payment : ${payments}">
                                        <td th:text="${payment.paymentDate}"></td>
                                        <td th:text="${payment.type}"></td>
                                        <td th:text="${payment.amount} + ' ' + ${payment.currency}"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Informazioni Utente</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Nome:</strong> <span th:text="${user.fullName}">-</span></p>
                        <p><strong>Username:</strong> <span th:text="${user.username}">-</span></p>
                        <p><strong>Email:</strong> <span th:text="${user.email}">-</span></p>
                        <p><strong>Tipo:</strong> <span th:text="${user.role}">-</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script th:src="@{/js/main.js}"></script>
</body>
</html>